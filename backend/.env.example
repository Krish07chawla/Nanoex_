# Copy this file to ".env" and edit the values. Never commit ".env".

# Database. SQLite works with no setup. For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/nanoex
DATABASE_URL=sqlite:///./nanoex.db

# Secret used to sign login tokens. Use a long random text.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-text

# The first admin account (created on first start).
ADMIN_EMAIL=admin@nanoex.in
ADMIN_PASSWORD=ChangeMe123

# Price feed: "yahoo" (real prices, ~15 min delayed) or "demo" (simulated prices).
MARKET_PROVIDER=yahoo

# AI advisor (Grok). Leave empty to use the built-in rule-based advisor.
XAI_API_KEY=
XAI_MODEL=grok-4
